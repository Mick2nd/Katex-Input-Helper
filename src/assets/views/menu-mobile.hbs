
<!-- The Menu -->
<div id="main-menu" class="easyui-menu">
	<div iconcls="icon-file">
		<span locate="FILE"></span>
		{{> menu-file }}
	</div> 
	
	<div id="mbINSERT" iconcls="icon-insert">
		<span locate="INSERT"></span>
		<div id="mINSERT" class="menus">
			<div iconcls="icon-char">
				<span class="rtl-menu-item" locate="CHAR"></span>
				{{> menu-chars id='id="mCHARS"' }}
			</div>
			{{> menu-insert }}
		</div>
	</div>
	<div iconcls="icon-plugin">
		<span locate="TOOLS"></span>
		{{> menu-tools }}
	</div>
	<div iconcls="icon-watch">
		<span locate="VIEW"></span>
		{{> menu-view }}
	</div> 
	<div iconcls="icon-option">
		<span locate="OPTIONS"></span>
		{{> menu-options }}
	</div> 
	<div iconcls="icon-info">
		<span locate="INFORMATIONS"></span>
		{{> menu-informations }}
	</div>
</div>
<!-- End of Menu -->
