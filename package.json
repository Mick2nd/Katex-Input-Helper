{
  "name": "joplin-plugin-katex-input-helper",
  "version": "3.0.2",
  "scripts": {
    "dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && npm run build-assets-prod && webpack --env joplin-plugin-config=createArchive",
    "dist-with-doc": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && npm run build-assets-prod && npm run build-docs && webpack --env joplin-plugin-config=createArchive",
    "prepare": "npm run dist",
    "updateVersion": "webpack --env joplin-plugin-config=updateVersion",
    "update": "npm install -g generator-joplin && yo joplin --node-package-manager npm --update --force",
    "build-docs": "typedoc --options typedoc.json --tsconfig src/assets/tsconfig.json && npm exec --package=@atao60/fse-cli fse copy ./img ./docs/img",
    "test": "vitest --root './tests' --run --reporter verbose --no-cache",
    "jtest": "jest",
    "build-assets": "webpack --config webpack.assets.config.ts --env kihmode=development",
    "build-assets-prod": "webpack --config webpack.assets.config.ts --env kihmode=production",
    "serve": "webpack serve --config webpack.assets.config.ts",
    "serve-prod": "webpack serve --config webpack.assets.config.ts --env kihmode=production",
    "stop-serve": "npx kill-port 9000",
    "deploy": "webpack --config webpack.assets.config.ts --env ghpages --env kihmode=production && gh-pages -d dist/assets"
  },
  "license": "MIT",
  "keywords": [
    "joplin-plugin"
  ],
  "files": [
    "publish"
  ],
  "overrides": {
    "tar": "^7.5.13",
    "form-data": "^4.0.5",
    "glob": "^13.0.6",
    "immer": "^11.1.4",
    "fast-xml-parser": "^5.6.0",
    "html-minifier": "^4.0.0",
    "mermaid": "^11.14",
    "deglob": {
      ".": "^3.1.0",
      "glob": "^7.0.5"
    },
    "@nodelib/fs.stat": "^4.0.0"
  },
  "devDependencies": {
    "@atao60/fse-cli": "^0.1.9",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/view": "^6.40.0",
    "@joplin/lib": "^2.6.3",
    "@rollup/plugin-inject": "^5.0.5",
    "@types/hammerjs": "^2.0.46",
    "@types/jquery": "^3.5.32",
    "@types/jsdom": "^21.1.7",
    "@types/katex": "^0.16.7",
    "@types/lodash": "^4.17.24",
    "@types/node": "^18.19.130",
    "@types/platform": "^1.3.6",
    "@uiw/codemirror-themes-all": "^4.25.9",
    "buffer": "^6.0.3",
    "chalk": "^4.1.0",
    "codemirror": "^6.0.2",
    "codemirror-lang-latex": "^0.2.0",
    "compression-webpack-plugin": "^12.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "file-loader": "^6.2.0",
    "fs-extra": "^10.1.0",
    "generate-file-webpack-plugin": "^1.0.1",
    "gh-pages": "^6.3.0",
    "glob": "^13.0.6",
    "hammerjs": "^2.0.8",
    "handlebars": "^4.7.8",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.3",
    "idb": "^8.0.3",
    "ignore-loader": "^0.1.2",
    "inversify": "^8.1.0",
    "inversify-inject-decorators": "^3.1.0",
    "jest": "^29.7.0",
    "jquery": "^3.7.1",
    "jquery-contextmenu": "^2.9.2",
    "json-loader": "^0.5.7",
    "katex": "^0.16.22",
    "lodash": "^4.18.1",
    "mini-css-extract-plugin": "^2.9.2",
    "mobile-detect": "^1.4.5",
    "node-device-detector": "^2.2.2",
    "path": "^0.12.7",
    "platform": "^1.3.6",
    "purgecss-webpack-plugin": "^8.0.0",
    "raw-loader": "^4.0.2",
    "reflect-metadata": "^0.2.2",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "tar": "^7.5.13",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typedoc": "^0.26.10",
    "typedoc-umlclass": "^0.10.0",
    "typescript": "^5.4.0",
    "unused-webpack-plugin": "^2.4.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.74.0",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.1"
  },
  "eslintConfig": {
    "plugins": [
      "de.habelt-jena.KatexInputHelper"
    ],
    "env": {
      "browser": true,
      "node": true,
      "de.habelt-jena.KatexInputHelper/custom": true
    }
  }
}
